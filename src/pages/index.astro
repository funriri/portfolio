---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
const skills = [['◎','Earth observation','Google Earth Engine · QGIS'],['◇','Soil & spatial analysis','Predictive soil mapping · PostgreSQL'],['⌘','Cloud & development','Google Cloud · Python · Docker'],['✳','Data science','Machine learning · TensorFlow']];
---
<Layout>
<section class="hero wrap" id="home"><div class="hero-copy"><div class="eyebrow"><i></i> A GEOSPATIAL PERSPECTIVE</div><h1>Making sense<br/>of our world,<br/><em>one layer at a time.</em></h1><p class="intro">I’m Rejoice, a data scientist working at the intersection of geospatial analytics, machine learning, and agricultural software. I turn Earth observation data into soil insights and tools that support farmers.</p><div class="actions"><a class="button" href="#projects">Explore my work →</a><a class="text-link" href={`${base}/cv/`}>View my CV →</a></div><p class="draft-note">Geospatial analytics · Soil mapping · Farmer advisory</p></div><div class="hero-art temperature-map"><img src={`${base}/images/southern-africa-temperature.webp`} alt="Map of land surface temperature differences across Southern Africa’s croplands, comparing 2023 with 2000" width="605" height="642" /></div></section>
<section class="skills wrap" aria-label="Technical focus areas">{skills.map(([icon,title,description])=><div class="skill"><span>{icon}</span><div><h2>{title}</h2><p>{description}</p></div></div>)}</section>
<section class="projects wrap" id="projects"><div class="section-heading"><div><div class="eyebrow">A FEW THINGS I’M EXPLORING</div><h2>Selected work<span>.</span></h2></div><span class="section-aside">Collection in progress</span></div><div class="project-grid">{projects.map(project=><a class="project-card" href={`${base}/projects/${project.id}/`}><div class={`project-image image-${project.id}`}><img src={`${base}${project.data.image}`} alt="" loading="lazy"/><span class="badge">{project.data.status === 'completed' ? 'COMPETITION PROJECT' : project.data.status === 'ongoing' ? 'IN DEVELOPMENT' : 'SAMPLE PROJECT'}</span><span class="project-arrow">→</span></div><div class="project-body"><div class="project-meta">{project.data.category}<span>0{project.data.order}</span></div><h3>{project.data.title}</h3><p>{project.data.summary}</p><div class="tags">{project.data.tags.map(tag=><span>{tag}</span>)}</div></div></a>)}</div><p class="sample-caption">Featuring the Pale Blue Dot competition and Virtual Agronomist. The spatial analysis card remains a sample.</p></section>
<section class="about" id="about"><div class="wrap about-grid"><div class="about-art"><span class="eyebrow">THE PERSON BEHIND THE MAPS</span><div class="portrait">RM<span>.</span></div><span class="photo-note">Your photo goes here →</span></div><div class="about-copy"><div class="eyebrow">HELLO, I’M REJOICE</div><h2>Curious by nature.<br/><em>Spatial by instinct.</em></h2><p>I’m a data scientist with a background in surveying and geomatics. My work connects Earth observation, predictive soil mapping, and software development to support agricultural decision-making.</p><p>At iSDA, I develop geospatial data workflows and machine learning models for soil mapping, and help build Virtual Agronomist. I lead its weather advisory, Know Your Soil, and Plant Health components, and mentor interns and junior developers.</p><div class="about-details"><div><span>FOCUS</span><strong>Geospatial data & agriculture</strong></div><div><span>BASED IN</span><strong>Zimbabwe · working remotely</strong></div></div><a class="text-link" href="#contact">Let’s start a conversation →</a></div></div></section>
<section class="experience wrap" id="experience"><div><div class="eyebrow">THE JOURNEY SO FAR</div><h2>From spatial insight<br/>to agricultural impact.</h2><p>Experience across geospatial analytics, agricultural software, research support, and estate GIS.</p><a class="outline-label" href={`${base}/cv/`}>View full CV →</a><div class="education-summary"><div class="eyebrow">EDUCATION</div><h3>{profile.education.degree}</h3><p>{profile.education.institution}<br/>{profile.education.dates}<br/>{profile.education.location}</p></div></div><div class="timeline">{profile.roles.map(role => <article><span>{role.dates} · {role.location}</span><h3>{role.title}</h3><p class="organization">{role.organization}</p><ul>{role.contributions.map(point => <li>{point}</li>)}</ul></article>)}</div></section>
<section class="contact wrap" id="contact"><div class="eyebrow">GOOD WORK STARTS WITH A CONVERSATION</div><h2>Let’s connect the dots<span>→</span></h2><div class="contact-bottom"><p>Interested in geospatial data, agricultural AI, or a collaboration?<br/>I’d love to hear from you.</p><div class="contact-links"><a href={`mailto:${profile.email}`}>Email →</a><a href="https://github.com/funriri" target="_blank" rel="noopener noreferrer">GitHub →</a><a href={`${base}/cv/`}>View CV →</a></div></div></section>
</Layout>
