---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){return (await getCollection('projects')).map(project=>({params:{id:project.id},props:{project}}));}
const { project }=Astro.props;
const { Content }=await render(project);
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<Layout title={`${project.data.title} — Portfolio`}><article class="case-study wrap"><a class="text-link" href={`${base}/#projects`}>← Back to selected work</a><div class="case-heading"><div class="eyebrow">{project.data.category} / {project.data.status === 'completed' ? 'COMPETITION PROJECT' : project.data.status === 'ongoing' ? 'IN DEVELOPMENT' : 'SAMPLE CASE STUDY'}</div><h1>{project.data.title}</h1><p>{project.data.summary}</p><div class="tags">{project.data.tags.map(tag=><span>{tag}</span>)}</div></div><div class:list={['case-image', {'poster-image': project.data.status === 'completed' || project.id === 'isdasoil'}]}><img src={`${base}${project.data.image}`} alt={project.data.imageAlt}/></div><div class="case-content"><aside><strong>{project.data.status === 'completed' ? 'Honorable Mention' : project.data.status === 'ongoing' ? 'Ongoing development' : 'A work in progress'}</strong><p>{project.data.caseNote ?? (project.data.status === 'completed' ? 'Pale Blue Dot: Visualization Challenge.' : project.data.status === 'ongoing' ? 'Work-related project. Demo and screenshots to follow; the illustration is a placeholder. Source code is not publicly available.' : 'This is illustrative content for the first draft. It does not represent completed work or verified results.')}</p></aside><div class="prose"><Content/></div></div></article></Layout>
